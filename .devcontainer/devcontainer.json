{
  "name": "noise-edit native + WASM",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {"version": "24"}
  },
  "forwardPorts": [8000],
  "runArgs": [
    "--shm-size=512m"
  ],
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/playwright.sh",
  "waitFor": "postStartCommand",
  "remoteEnv": {
    "NODE_PATH": "/home/vscode/.local/share/thenoise-web-tools/node_modules",
    "PLAYWRIGHT_BROWSERS_PATH": "/home/vscode/.local/share/thenoise-web-tools/browsers",
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/share/thenoise-web-tools/node_modules/.bin"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "cmake.generator": "Ninja",
        "cmake.buildDirectory": "${workspaceFolder}/build-devcontainer",
        "cmake.configureOnOpen": false
      },
      "extensions": [
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-python.python"
      ]
    }
  }
}
