{
  "id": "region-fill",
  "label": "Fill",
  "operation": "reconstruct",
  "endpoint": "edits",
  "role": "edit",
  "region": "selection",
  "prep": "white",
  "enhance": "never",
  "include_references_default": true,
  "prompt": [
    "Draw {{prompt}} in the marked area of this image.",
    "Match the colour, brightness, light direction, perspective, focus and grain of the",
    "surrounding {{context_desc}}.",
    "Change nothing outside the marked area."
  ],
  "variables": {
    "context_desc": "background"
  },
  "ask": [
    "prompt"
  ],
  "composite": {
    "feather": "auto",
    "colour_match": true,
    "lock_band_px": 4
  }
}
