{
  "id": "new-image-photo",
  "label": "New image (photo)",
  "operation": "from_words",
  "endpoint": "generations",
  "role": "generate.photo",
  "region": "document",
  "prep": "none",
  "context": {
    "ratio": 0.0,
    "min_px": 0
  },
  "enhance": "never",
  "prompt": [
    "{{prompt}}",
    "Photograph: natural lighting, plausible optics and depth of field, fine texture.",
    "Compose the whole frame; there is no existing image to preserve."
  ],
  "composite": {
    "feather": "none",
    "colour_match": false,
    "lock_band_px": 0
  },
  "ask": [
    "prompt"
  ],
  "aspects": [
    "1:1",
    "3:4",
    "4:3",
    "16:9"
  ]
}
